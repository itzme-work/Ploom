{
  "productName": "Ploom",
  "identifier": "work.itzme.ploom",
  "version": "0.2.0",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ploom",
        "width": 980,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": [
        {
          "identifier": "main-local",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-library-key",
            "allow-install-update",
            "allow-subscription-fetch",
            "allow-subscription-dns","allow-subscription-probe",
            "deep-link:allow-get-current",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "allow-library-export"
          ]
        },
        {
          "identifier": "android-download",
          "platforms": [
            "android"
          ],
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-cancel-download",
            "allow-open-update-browser"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "basicUi"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ploom"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "ploom"
          ],
          "host": "import",
          "appLink": false
        }
      ]
    }
  }
}
